# QuickBooks Online development/sandbox configuration
# Copy this file to .env and fill values locally. Never commit .env.
QBO_CLIENT_ID=<sandbox-client-id>
QBO_CLIENT_SECRET=<sandbox-client-secret>
QBO_REDIRECT_URI=<https-public-base-url>/api/v1/integrations/qbo/callback
QBO_ENVIRONMENT=sandbox
QBO_BASE_URL=<sandbox-qbo-base-url>
QBO_AUTHORIZATION_URL=<qbo-authorization-url>
QBO_TOKEN_URL=<qbo-token-url>
QBO_SCOPE=<qbo-scope>

# Application
APP_ENVIRONMENT=development
APP_BASE_URL=<https-public-base-url>
FRONTEND_STATIC_DIR=frontend/dist
FINZ_REPOSITORY_BACKEND=memory
FINZ_DEMO_RESET_SECRET=<dedicated-random-reset-secret>
FINZ_DEMO_ACCESS_CODE=<interviewer-access-code-at-least-12-characters>

# MongoDB
MONGODB_URI=<mongodb-uri>
MONGODB_DATABASE=finz_ledger_bridge

# Local Docker MongoDB only. Generate real local passwords with:
# D:\MISM\Finz\.venv312\Scripts\python.exe scripts\ensure_local_mongodb_secrets.py
FINZ_MONGO_ROOT_USERNAME=finz_root
FINZ_MONGO_ROOT_PASSWORD=
FINZ_MONGO_APP_USERNAME=finz_app
FINZ_MONGO_APP_PASSWORD=
FINZ_MONGO_APP_DATABASE=finz_ledger_bridge
FINZ_MONGODB_PORT=27017
FINZ_LOCAL_MONGODB_URI=
